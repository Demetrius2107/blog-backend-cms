# 编译产物
*.class
*.jar
*.war

# 构建目录（必须锚定根目录，否则会误伤 Java 包目录如 publish/domain/build/）
target/
/build/

# IntelliJ IDEA配置
.idea/
*.iml
*.ipr
*.iws

# 日志文件
*.log
logs/

# 系统文件
.DS_Store
Thumbs.db

# 接口文档导出
article-api-docs.json

# Node.js
node_modules/
package-lock.json

# blog-cli 预览临时文件
blog-cli/.preview/

# AI 工具本地配置
.atomcode/
.qoder/
.zcode/

# 静态站构建产物（由 fetch-content 脚本生成）
blog-site/posts/
blog-site/dist/
blog-site/node_modules/
